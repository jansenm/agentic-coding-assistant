# Copy to .env and fill in. .env is git-ignored (ADR 008).
ANTHROPIC_API_KEY=sk-ant-...

# Adhoc/live probes: override the model per run so metered cloud
# quota is not burned by agent-testing. Example:
#   AGENT_MODEL=ollama:nemotron-3-ultra:cloud mix tui
# AGENT_MODEL=

# Cloud-direct ollama (base_url https://ollama.com in auth.toml) needs a
# key; the keyless local proxy does not. Put real keys in
# ~/.local/share/coding-agent/auth.toml (ADR 014) or the environment.
# OLLAMA_API_KEY=
